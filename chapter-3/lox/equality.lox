//compare nil, booleans, numbers, strings, and instances.
print nil == nil;

print true == true;
print false == true;

print 42 == 42;
print 42 == "42";

print "lox" == "lox";
print "lox" != "craft";

class Box {}

var left = Box();
var right = Box();
var alias = left;

print left == right;
print left == alias;
